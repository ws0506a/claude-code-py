# Required: API key for any OpenAI-compatible service.
OPENAI_API_KEY=sk-...

# Optional: point at a non-OpenAI endpoint (DeepSeek, Qwen, Kimi, Together, vLLM, ...).
# Leave unset to use api.openai.com.
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_BASE_URL=https://api.moonshot.cn/v1

# Optional: default model name. CLI --model overrides this.
# QINGCODE_MODEL=deepseek-chat
# QINGCODE_MODEL=qwen-plus
# QINGCODE_MODEL=moonshot-v1-32k
